@model ChatPageContentViewModel

<div class="chat-sidebar-header">
    <div>
        <span class="eyebrow">Mensajes</span>
        <h1>Conversaciones</h1>
    </div>
    <span class="chat-sidebar-count">@Model.Inbox.Count</span>
</div>

<div class="chat-inbox" data-chat-inbox>
    @if (Model.Inbox.Count == 0)
    {
        <div class="empty-state compact-empty">
            <h3>Sin mensajes todavia</h3>
            <p>Cuando escribas desde un anuncio, tus conversaciones apareceran aca.</p>
        </div>
    }
    else
    {
        @foreach (var item in Model.Inbox)
        {
            var isActive = Model.SelectedConversation?.ConversationId == item.ConversationId;
            <a class="chat-inbox-item @(isActive ? "is-active" : string.Empty)"
               href="/Mensajes/@item.ConversationId"
               data-chat-inbox-item
               data-conversation-id="@item.ConversationId">
                <div class="chat-inbox-copy">
                    <div class="chat-inbox-topline">
                        <strong>@item.OtherParticipantName</strong>
                        <time datetime="@item.LastMessageAtUtc?.ToString("O")">@FormatRelative(item.LastMessageAtUtc)</time>
                    </div>
                    <div class="chat-inbox-publication">@item.PublicationTitle</div>
                </div>
                <div class="chat-inbox-meta">
                    @if (item.UnreadCount > 0)
                    {
                        <span class="chat-unread-pill">@item.UnreadCount</span>
                    }
                </div>
            </a>
        }
    }
</div>

@functions {
    private static string FormatRelative(DateTime? value)
    {
        if (!value.HasValue)
        {
            return string.Empty;
        }

        var local = value.Value.ToLocalTime();
        var now = DateTime.Now;
        var delta = now - local;

        if (delta.TotalMinutes < 1)
        {
            return "Ahora";
        }

        if (delta.TotalHours < 1)
        {
            return $"Hace {(int)delta.TotalMinutes} min";
        }

        if (delta.TotalDays < 1)
        {
            return local.ToString("HH:mm");
        }

        return local.ToString("dd/MM");
    }
}
