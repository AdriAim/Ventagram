@model ChatPageContentViewModel

<section class="chat-shell" data-chat-app data-current-user-id="@Model.CurrentUserId">
    <aside class="chat-sidebar">
        <div data-chat-sidebar-content>
            <partial name="_Inbox" model="Model" />
        </div>
    </aside>

    <section class="chat-thread" data-chat-thread-container>
        <partial name="_Thread" model="Model" />
    </section>
</section>
