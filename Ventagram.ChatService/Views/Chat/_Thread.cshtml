@model ChatPageContentViewModel

@if (Model.SelectedConversation is null)
{
    <div class="empty-state chat-empty-thread">
        <div>
            <h2>Selecciona una conversacion</h2>
            <p>Elige un hilo a la izquierda o entra desde el boton de chat de un anuncio.</p>
        </div>
    </div>
}
else
{
    var conversation = Model.SelectedConversation;
    <div class="chat-thread-shell" data-chat-thread data-conversation-id="@conversation.ConversationId">
        <header class="chat-thread-header">
            <div class="chat-thread-summary">
                <div class="chat-thread-participant">
                    <span class="eyebrow">Conversacion</span>
                    <strong>@conversation.OtherParticipantName</strong>
                </div>
                <div class="chat-thread-participant">
                    <span class="eyebrow">Anuncio</span>
                    <a class="chat-thread-publication-link" href="@conversation.PublicationDetailsUrl">@conversation.PublicationTitle</a>
                    <span>@conversation.PublicationPrice · @conversation.PublicationLocality</span>
                </div>
            </div>
        </header>

        <div class="chat-message-list" data-chat-message-list>
            @foreach (var message in conversation.Messages)
            {
                <article class="chat-message @(message.IsMine ? "is-mine" : string.Empty)" data-chat-message-id="@message.Id">
                    <div class="chat-message-bubble">
                        <p>@message.Body</p>
                    </div>
                    <div class="chat-message-meta">
                        <time datetime="@message.CreatedAtUtc.ToString("O")">@FormatMessageTime(message.CreatedAtUtc)</time>
                        @if (message.IsMine)
                        {
                            <span class="chat-message-read-state" data-message-read-status>
                                @(message.ReadAtUtc.HasValue ? $"Leido {FormatMessageTime(message.ReadAtUtc.Value)}" : "Enviado")
                            </span>
                        }
                    </div>
                </article>
            }
        </div>

        <form class="chat-compose" data-chat-compose-form>
            <label class="visually-hidden" for="chatMessageBody">Escribe tu mensaje</label>
            <textarea id="chatMessageBody"
                      name="body"
                      rows="4"
                      maxlength="2000"
                      placeholder="Escribe sobre este anuncio..."
                      data-chat-compose-input></textarea>
            <div class="chat-compose-footer">
                <span class="field-hint" data-chat-compose-counter>0 / 2000</span>
                <button type="submit" class="primary-pill">Enviar</button>
            </div>
        </form>
    </div>
}

@functions {
    private static string FormatMessageTime(DateTime value)
    {
        return value.ToLocalTime().ToString("dd/MM HH:mm");
    }
}
