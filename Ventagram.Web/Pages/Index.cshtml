@page
@model IndexModel
@{
    ViewData["Title"] = "Compra venta Argentina de inmuebles, rodados y anuncios";
    ViewData["MetaDescription"] = "Compra venta Argentina en Ventagram. Publica anuncios clasificados de inmuebles, rodados y mas con precios visibles, mapa, galeria y texto.";
    var endpoint = $"/api/content/home?group={Uri.EscapeDataString(Model.Group)}&mode={Uri.EscapeDataString(Model.Mode)}&query={Uri.EscapeDataString(Model.Query ?? string.Empty)}";
}

<div id="api-page"
     data-page-kind="home"
     data-api-endpoint="@endpoint">
</div>

<partial name="_GlobalModals" model="Model" />
