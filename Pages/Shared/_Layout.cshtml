@using Ventagram.Services
@inject NavigationLocalityService NavigationLocalityService
@inject IConfiguration Configuration
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Ventagram</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Cormorant+Garamond:wght@600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body data-user-authenticated="@((User.Identity?.IsAuthenticated ?? false) ? "true" : "false")">
    <div class="page-backdrop"></div>
    @{
        var headerGroup = Context.Request.Query["group"].ToString();
        var headerMode = Context.Request.Query["mode"].ToString();
        var headerGroupActive = string.IsNullOrWhiteSpace(headerGroup) ? "Todos" : headerGroup;
        var headerModeActive = string.IsNullOrWhiteSpace(headerMode) ? string.Empty : headerMode;
        var navigationLocality = await NavigationLocalityService.GetEffectiveLocalityAsync(Context);
        var availableHeaderLocalities = await NavigationLocalityService.GetAvailableLocalitiesAsync();
        var currentHeaderLocality = navigationLocality?.DisplayLabel ?? string.Empty;
        var chatBaseUrl = (Configuration["Chat:BaseUrl"] ?? string.Empty).TrimEnd('/');
        if (chatBaseUrl.Contains(".example.com", StringComparison.OrdinalIgnoreCase))
        {
            chatBaseUrl = string.Empty;
        }
        var chatMailboxUrl = "/Mensajes";
    }
    <header class="site-header">
        <nav class="site-nav">
            <a class="brand-lockup" asp-page="/Index">
                <img class="brand-mark" src="~/images/logo5.png" alt="Ventagram" />
                <span class="brand-text">
                    <strong>Ventagram</strong>
                    <small>Comunidad y Anuncios</small>
                </span>
            </a>
            <div class="site-nav-center">
                <div class="header-category-strip" aria-label="Categorias principales">
                    <a class="category-chip @(headerGroupActive == "Inmuebles" ? "active" : "")" href="/Buscar?group=Inmuebles@(string.IsNullOrWhiteSpace(headerModeActive) ? string.Empty : $"&mode={headerModeActive}")#search-panel">
                        <span class="category-icon" aria-hidden="true"><i class="fa-solid fa-house"></i></span>
                        <span class="category-label">Inmuebles</span>
                    </a>
                    <a class="category-chip @(headerGroupActive == "Rodados" ? "active" : "")" href="/Buscar?group=Rodados@(string.IsNullOrWhiteSpace(headerModeActive) ? string.Empty : $"&mode={headerModeActive}")#search-panel">
                        <span class="category-icon" aria-hidden="true"><i class="fa-solid fa-car-side"></i></span>
                        <span class="category-label">Rodados</span>
                    </a>
                    <a class="category-chip @(headerGroupActive == "Embarcaciones" ? "active" : "")" href="/Buscar?group=Embarcaciones@(string.IsNullOrWhiteSpace(headerModeActive) ? string.Empty : $"&mode={headerModeActive}")#search-panel">
                        <span class="category-icon" aria-hidden="true"><i class="fa-solid fa-ship"></i></span>
                        <span class="category-label">Embarcaciones</span>
                    </a>
                    <a class="category-chip @(headerGroupActive == "Generales" ? "active" : "")" href="/Buscar?group=Generales@(string.IsNullOrWhiteSpace(headerModeActive) ? string.Empty : $"&mode={headerModeActive}")#search-panel">
                        <span class="category-icon" aria-hidden="true"><i class="fa-solid fa-mobile-screen-button"></i></span>
                        <span class="category-label">Electronica</span>
                    </a>
                    <a class="category-chip @(headerGroupActive == "Todos" ? "active" : "")" href="/Buscar?group=Todos@(string.IsNullOrWhiteSpace(headerModeActive) ? string.Empty : $"&mode={headerModeActive}")#search-panel">
                        <span class="category-icon" aria-hidden="true"><i class="fa-solid fa-globe"></i></span>
                        <span class="category-label">Todos</span>
                    </a>
                </div>
                <div class="site-nav-divider" aria-hidden="true"></div>
                <div class="nav-links">
                    <a class="nav-main-link" href="/Buscar#search-panel">
                        <i class="fa-solid fa-compass fa-fw" aria-hidden="true"></i>
                        <span>Explorar</span>
                    </a>
                    <a class="nav-main-link" asp-page="/Publications/Create">
                        <i class="fa-solid fa-circle-plus fa-fw" aria-hidden="true"></i>
                        <span>Publicar</span>
                    </a>
                    <a class="nav-main-link" asp-page="/Favorites" data-auth-required-favorites="@((User.Identity?.IsAuthenticated ?? false) ? "false" : "true")">
                        <i class="fa-solid fa-star fa-fw" aria-hidden="true"></i>
                        <span>Mis favoritos</span>
                    </a>
                </div>
            </div>
            <div class="nav-actions">
                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    <a class="mailbox-button"
                       href="@chatMailboxUrl"
                       data-chat-mailbox-button
                       data-chat-unread-state="0"
                       aria-label="Mensajes"
                       title="Mensajes">
                        <i class="fa-solid fa-envelope" aria-hidden="true"></i>
                        <span class="mailbox-count" data-chat-unread-count hidden>0</span>
                    </a>
                    <details class="user-menu">
                        <summary class="user-menu-toggle" title="Hace click para ver configuración del usuario y sus publicaciones">
                            <span class="user-badge">@User.Identity!.Name</span>
                            <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
                        </summary>
                        <div class="user-menu-panel">
                            <a asp-page="/MyPublications">
                                <i class="fa-solid fa-rectangle-list" aria-hidden="true"></i>
                                <span>Mis publicaciones</span>
                            </a>
                            <a asp-page="/Favorites">
                                <i class="fa-solid fa-star" aria-hidden="true"></i>
                                <span>Favoritos</span>
                            </a>
                            <a asp-page="/Account/ChangePassword">
                                <i class="fa-solid fa-key" aria-hidden="true"></i>
                                <span>Cambiar contrasena</span>
                            </a>
                            <a asp-page="/Account/ChangeLocality">
                                <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
                                <span>Cambiar localidad</span>
                            </a>
                            <a asp-page="/Account/Settings">
                                <i class="fa-solid fa-sliders" aria-hidden="true"></i>
                                <span>Otras configuraciones</span>
                            </a>
                            <form method="post" asp-page="/Account/Logout">
                                <button type="submit">
                                    <i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i>
                                    <span>Salir</span>
                                </button>
                            </form>
                        </div>
                    </details>
                }
                else
                {
                    <a class="ghost-pill compact" asp-page="/Account/Login">Ingresar</a>
                    <a class="primary-pill compact" asp-page="/Account/Register">Crear cuenta</a>
                }
            </div>
            <div class="header-locality-bar" data-header-locality-form>
                <div class="header-locality-main">
                    <span class="header-locality-selected">
                        <i class="fa-solid fa-location-dot"></i>
                        <span data-header-locality-current>
                            @(string.IsNullOrWhiteSpace(currentHeaderLocality) ? "Sin localidad" : $"Anuncios cerca de {currentHeaderLocality}")
                        </span>
                    </span>
                    <input type="text"
                           class="header-locality-input"
                           list="header-locality-options"
                           value=""
                           placeholder="buscar localidad"
                           aria-label="Localidad para buscar"
                           data-header-locality-input />
                    <button type="button" class="header-locality-action" data-header-locality-detect>Detectar</button>
                </div>
                <datalist id="header-locality-options">
                    @foreach (var locality in availableHeaderLocalities)
                    {
                        var optionLabel = $"{locality.Locality}, {locality.Province}";
                        <option value="@optionLabel"
                                data-locality-id="@locality.Id"
                                data-locality="@locality.Locality"
                                data-province="@locality.Province"
                                data-latitude="@locality.Latitude"
                                data-longitude="@locality.Longitude"></option>
                    }
                </datalist>
                <span class="header-locality-status" data-header-locality-status></span>
            </div>
        </nav>
    </header>
    <main class="page-shell">
        @RenderBody()
    </main>
    <div class="preview-overlay" id="authRequiredModal" hidden>
        <div class="preview-backdrop" data-auth-required-close="true"></div>
        <div class="preview-dialog preview-dialog-compact">
            <div class="modal-content ventagram-modal preview-modal-shell report-modal-shell">
                <div class="modal-header">
                    <div class="preview-modal-title">
                        <img class="preview-modal-logo" src="~/images/logo5.png" alt="Ventagram" />
                        <h5 class="modal-title">Favoritos disponibles con cuenta</h5>
                    </div>
                    <button type="button" class="btn-close" data-auth-required-close="true" aria-label="Cerrar"></button>
                </div>
                <div class="preview-modal-body auth-required-body">
                    <p>Puedes crear listas de anuncios favoritos para hacerle seguimiento, funcionalidad solo disponible para usuarios registrados.</p>
                    <div class="report-actions">
                        <a class="ghost-pill" asp-page="/Account/Login">Ingresar</a>
                        <a class="primary-pill" asp-page="/Account/Register">Crear usuario</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <footer class="site-footer">
        <div class="footer-brand">
            <img class="footer-mark" src="~/images/logo5.png" alt="Ventagram" />
            <div>
                <strong>Ventagram</strong>
                <p>Comunidad y Anuncios</p>
            </div>
        </div>
        <div class="footer-links">
            <a asp-page="/Contacto">Contacto</a>
            <a asp-page="/Legales">Legales</a>
            <a asp-page="/Privacy">Privacidad</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/typeahead/typeahead.bundle.min.js"></script>
    <script>
        window.__VENTAGRAM_CHAT_CONFIG = {
            baseUrl: "@chatBaseUrl"
        };
    </script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
