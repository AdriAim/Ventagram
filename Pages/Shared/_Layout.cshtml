<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Ventagram</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Cormorant+Garamond:wght@600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="page-backdrop"></div>
    @{
        var headerGroup = Context.Request.Query["group"].ToString();
        var headerMode = Context.Request.Query["mode"].ToString();
        var headerGroupActive = string.IsNullOrWhiteSpace(headerGroup) ? "Todos" : headerGroup;
        var headerModeActive = string.IsNullOrWhiteSpace(headerMode) ? string.Empty : headerMode;
    }
    <header class="site-header">
        <nav class="site-nav">
            <a class="brand-lockup" asp-page="/Index">
                <img class="brand-mark" src="~/images/logo5.png" alt="Ventagram" />
                <span class="brand-text">
                    <strong>Ventagram</strong>
                    <small>Comunidad y Anuncios</small>
                </span>
            </a>
            <div class="site-nav-center">
                <div class="header-category-strip" aria-label="Categorias principales">
                    <a class="category-chip @(headerGroupActive == "Inmuebles" ? "active" : "")" href="/Buscar?group=Inmuebles@(string.IsNullOrWhiteSpace(headerModeActive) ? string.Empty : $"&mode={headerModeActive}")">
                        <span class="category-icon" aria-hidden="true"><i class="fa-solid fa-house"></i></span>
                        <span class="category-label">Inmuebles</span>
                    </a>
                    <a class="category-chip @(headerGroupActive == "Rodados" ? "active" : "")" href="/Buscar?group=Rodados@(string.IsNullOrWhiteSpace(headerModeActive) ? string.Empty : $"&mode={headerModeActive}")">
                        <span class="category-icon" aria-hidden="true"><i class="fa-solid fa-car-side"></i></span>
                        <span class="category-label">Rodados</span>
                    </a>
                    <a class="category-chip @(headerGroupActive == "Embarcaciones" ? "active" : "")" href="/Buscar?group=Embarcaciones@(string.IsNullOrWhiteSpace(headerModeActive) ? string.Empty : $"&mode={headerModeActive}")">
                        <span class="category-icon" aria-hidden="true"><i class="fa-solid fa-ship"></i></span>
                        <span class="category-label">Embarcaciones</span>
                    </a>
                    <a class="category-chip @(headerGroupActive == "Generales" ? "active" : "")" href="/Buscar?group=Generales@(string.IsNullOrWhiteSpace(headerModeActive) ? string.Empty : $"&mode={headerModeActive}")">
                        <span class="category-icon" aria-hidden="true"><i class="fa-solid fa-mobile-screen-button"></i></span>
                        <span class="category-label">Electronica</span>
                    </a>
                    <a class="category-chip @(headerGroupActive == "Todos" ? "active" : "")" href="/Buscar?group=Todos@(string.IsNullOrWhiteSpace(headerModeActive) ? string.Empty : $"&mode={headerModeActive}")">
                        <span class="category-icon" aria-hidden="true"><i class="fa-solid fa-globe"></i></span>
                        <span class="category-label">Todos</span>
                    </a>
                </div>
                <div class="site-nav-divider" aria-hidden="true"></div>
                <div class="nav-links">
                    <a href="/Buscar">Explorar</a>
                    <a asp-page="/Publications/Create">Publicar</a>
                </div>
            </div>
            <div class="nav-actions">
                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    <span class="user-badge">@User.Identity!.Name</span>
                    <form method="post" asp-page="/Account/Logout">
                        <button type="submit" class="ghost-pill compact">Salir</button>
                    </form>
                }
                else
                {
                    <a class="ghost-pill compact" asp-page="/Account/Login">Ingresar</a>
                    <a class="primary-pill compact" asp-page="/Account/Register">Crear cuenta</a>
                }
            </div>
        </nav>
    </header>
    <main class="page-shell">
        @RenderBody()
    </main>
    <footer class="site-footer">
        <div class="footer-brand">
            <img class="footer-mark" src="~/images/logo5.png" alt="Ventagram" />
            <div>
                <strong>Ventagram</strong>
                <p>Basta de anuncios sin precios. La comunidad denuncia, vota y manda avisos a la papelera.</p>
            </div>
        </div>
        <div class="footer-links">
            <a asp-page="/Index">Inicio</a>
            <a asp-page="/Publications/Create">Publicar</a>
            <a asp-page="/Trash">Papelera</a>
            <a asp-page="/Privacy">Privacidad</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
