@using System.Globalization
@model CreatePublicationContentViewModel
@{
    ViewData["Title"] = "Crear publicacion";
}

<section class="form-shell create-shell">
    <div class="section-heading">
        <span class="eyebrow">Publicacion nueva</span>
        <h1>Crear publicacion</h1>
        <p>Elegi la ubicacion, subi las imagenes y completa los datos minimos.</p>
    </div>

    @if (Model.RequiresLogin)
    {
        <section class="empty-state">
            <h2>Solo usuarios registrados</h2>
            <p>Inicia sesion para publicar anuncios con mapa, imagenes y contacto asociado a tu cuenta.</p>
            <a class="primary-pill" href="/Account/Login?returnUrl=/Publications/Create">Iniciar sesion</a>
        </section>
    }
    else
    {
        <div class="status-banner civic-banner">
            <strong>Publicas como @(Model.CurrentUserName ?? "usuario registrado")</strong>
            <span>Tu cuenta queda asociada a esta publicacion.</span>
        </div>

        <div id="create-feedback"></div>

        <form id="createPublicationForm" class="stack-form create-form" autocomplete="off" novalidate>
            <input type="hidden" name="title" value="@Model.Input.Title" />
            <input type="hidden" name="latitude" value="@(Model.Input.Latitude.HasValue ? Model.Input.Latitude.Value.ToString(CultureInfo.InvariantCulture) : string.Empty)" />
            <input type="hidden" name="longitude" value="@(Model.Input.Longitude.HasValue ? Model.Input.Longitude.Value.ToString(CultureInfo.InvariantCulture) : string.Empty)" />
            <input type="hidden" name="locality" value="@Model.Input.Locality" />
            <input type="hidden" name="address" value="@Model.Input.Address" />
            <input type="hidden" name="imagesCsv" value="@Model.Input.ImagesCsv" />

            <section class="detail-panel create-uploads-panel">
                <div class="section-heading">
                    <span class="eyebrow">Datos minimos</span>
                    <h2>Completa lo esencial</h2>
                    <p>El titulo se arma automaticamente a partir de la categoria y la ubicacion seleccionada.</p>
                </div>

                <div class="form-grid">
                    <label data-field-container="group">
                        <span>Tipo</span>
                        <select name="group">
                            @foreach (var group in Model.GroupOptions)
                            {
                                if ((byte)Model.Input.Group == group.Id)
                                {
                                    <option value="@group.Id" selected>@group.Name</option>
                                }
                                else
                                {
                                    <option value="@group.Id">@group.Name</option>
                                }
                            }
                        </select>
                        <span class="field-error" data-field-error="group"></span>
                    </label>

                    <label data-field-container="category">
                        <span>Categoria</span>
                        <select name="category"
                                data-category-select
                                data-category-endpoint="/api/content/categories"
                                data-selected-category="@Model.Input.Category">
                            <option value="">Selecciona una categoria</option>
                            @foreach (var category in Model.Categories)
                            {
                                if (string.Equals(category.Name, Model.Input.Category, StringComparison.OrdinalIgnoreCase))
                                {
                                    <option value="@category.Name" selected>@category.Name</option>
                                }
                                else
                                {
                                    <option value="@category.Name">@category.Name</option>
                                }
                            }
                        </select>
                        <span class="field-error" data-field-error="category"></span>
                    </label>

                    <label class="wide" data-field-container="shortDescription">
                        <span>Descripcion corta</span>
                        <input name="shortDescription" value="@Model.Input.ShortDescription" placeholder="Resumen breve para el listado" />
                        <span class="field-error" data-field-error="shortDescription"></span>
                    </label>

                    <label data-field-container="currency">
                        <span>Moneda</span>
                        <select name="currency">
                            @if (Model.Input.Currency == "ARS")
                            {
                                <option value="ARS" selected>ARS</option>
                            }
                            else
                            {
                                <option value="ARS">ARS</option>
                            }

                            @if (Model.Input.Currency == "USD")
                            {
                                <option value="USD" selected>USD</option>
                            }
                            else
                            {
                                <option value="USD">USD</option>
                            }
                        </select>
                        <span class="field-error" data-field-error="currency"></span>
                    </label>

                    <label data-field-container="price">
                        <span>Precio</span>
                        <input name="price" type="number" step="0.01" min="0" value="@Model.Input.Price" />
                        <span class="field-error" data-field-error="price"></span>
                    </label>

                    <label class="wide" data-field-container="longDescription">
                        <span>Descripcion completa</span>
                        <textarea name="longDescription" placeholder="Conta lo importante de la publicacion">@Model.Input.LongDescription</textarea>
                        <span class="field-error" data-field-error="longDescription"></span>
                    </label>
                </div>
            </section>

            <section class="detail-panel create-map-panel">
                <div class="section-heading">
                    <span class="eyebrow">Ubicacion</span>
                    <h2>Marca el punto en el mapa</h2>
                    <p>Busca una direccion o hace clic sobre el mapa para fijar la ubicacion de la publicacion.</p>
                </div>

                <label class="checkline compact-check">
                    <input name="noLocation" type="checkbox" data-create-no-location />
                    <span>No quiero ubicar en el mapa. (Esto excluira el anuncio de las busquedas por mapa)</span>
                </label>

                <div class="create-map-toolbar">
                    <label class="wide" data-field-container="locationSearch">
                        <span>Buscar direccion</span>
                        <input name="locationSearch" type="text" value="@Model.SuggestedLocalityLabel" placeholder="Calle, numero, barrio o ciudad" />
                        <span class="field-error" data-field-error="locationSearch"></span>
                    </label>
                    <button type="button" class="primary-pill large" data-create-address-search>Buscar</button>
                </div>

                <div class="create-map-canvas" data-create-map data-maptiler-key="@Model.MapTilerKey"></div>
                <p class="create-map-summary" data-create-location-summary>
                    @(string.IsNullOrWhiteSpace(Model.SuggestedLocalityLabel)
                        ? "Elegi una ubicacion en el mapa o buscala por direccion."
                        : $"Ubicacion sugerida segun tu cuenta: {Model.SuggestedLocalityLabel}.")
                </p>
            </section>

            <section class="detail-panel create-uploads-panel">
                <div class="section-heading">
                    <span class="eyebrow">Imagenes</span>
                    <h2>Subi una principal y hasta 10 mas</h2>
                    <p>Arrastra y suelta archivos o usa el selector. La primera se toma como principal y podes reorganizarla despues.</p>
                </div>

                <div class="upload-dropzone" data-image-dropzone data-field-container="imagesCsv">
                    <input type="file" multiple accept="image/*" data-create-images-input hidden />
                    <div class="upload-dropzone-actions">
                        <button type="button" class="primary-pill" data-create-images-pick>Elegir imagenes</button>
                        <button type="button" class="ghost-pill" data-create-images-clear>Limpiar todo</button>
                        <span class="field-hint" data-image-count>0/11 imagenes</span>
                    </div>
                    <div class="upload-previews" data-image-previews></div>
                    <p class="field-hint">Podes cargar una imagen principal y hasta 10 adicionales. Se guardan en formato web para la publicacion.</p>
                    <span class="field-error" data-field-error="imagesCsv"></span>
                </div>
            </section>

            <div class="hero-actions">
                <button type="submit" class="primary-pill">Publicar</button>
                <a class="ghost-pill" href="/">Cancelar</a>
            </div>
        </form>
    }
</section>
