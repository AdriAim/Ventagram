@using System.Text.Json
@model PublicationDetailsContentViewModel

@if (Model.Publication is null)
{
    <section class="empty-state">
        <h1>Publicación no encontrada</h1>
        <p>Es posible que haya vencido o sido dada de baja.</p>
    </section>
}
else
{
    var publication = Model.Publication;
    var displayTitle = publication.Title.Split(" - oportunidad", StringSplitOptions.TrimEntries)[0];
    var owner = publication.User;
    var canEmail = owner?.RespondsEmails == true || (owner is null && !string.IsNullOrWhiteSpace(publication.ContactEmail));
    var canCall = owner?.AcceptsCalls == true || (owner is null && !string.IsNullOrWhiteSpace(publication.ContactPhone));
    var canWhatsApp = owner?.RespondsWhatsApp == true || (owner is null && !string.IsNullOrWhiteSpace(publication.ContactPhone));
    var contactEmail = publication.ContactEmail ?? owner?.Email ?? string.Empty;
    var contactPhone = publication.ContactPhone ?? owner?.Phone ?? string.Empty;
    var whatsappNumber = NormalizeWhatsAppNumber(contactPhone);

    <section class="detail-hero">
        <div>
            <span class="eyebrow">@publication.Group · @publication.Category</span>
            <h1><span class="detail-title-text">@displayTitle</span></h1>
            <p>@publication.ShortDescription</p>
        </div>
        <div class="price-panel">
            <strong>@publication.Currency @publication.Price.ToString("N0")</strong>
            <span>@publication.Locality</span>
            <span>@publication.ContactName</span>
        </div>
    </section>

    <section class="detail-grid">
        <div class="detail-gallery">
            @foreach (var image in publication.ImageList)
            {
                <img src="@image" alt="@displayTitle" />
            }
        </div>
        <aside class="detail-panel">
            <h2>Contacto</h2>
            <p><strong>@publication.ContactName</strong></p>
            @if (canEmail && !string.IsNullOrWhiteSpace(contactEmail))
            {
                <p>
                    <a class="whatsapp-link contact-email-link" href="mailto:@contactEmail">
                        <span class="contact-email-mark" aria-hidden="true">
                            <svg viewBox="0 0 24 24" role="img" aria-hidden="true">
                                <path fill="currentColor" d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm0 4.2-8 4.8-8-4.8V6l8 4.8L20 6v2.2Z" />
                            </svg>
                        </span>
                        <span>Mail a: @contactEmail</span>
                    </a>
                </p>
            }
            @if (canCall && !string.IsNullOrWhiteSpace(contactPhone))
            {
                <p>
                    <a class="call-link" href="tel:@contactPhone">
                        <span class="call-mark" aria-hidden="true">
                            <svg viewBox="0 0 24 24" role="img" aria-hidden="true">
                                <path fill="currentColor" d="M6.2 3.1c.6-.6 1.5-.8 2.2-.6l2 .7c.8.3 1.3 1 1.4 1.8l.2 1.8c0 .7-.3 1.4-.9 1.8l-1.4.9c-.4.3-.5.8-.3 1.2.8 1.8 2.3 3.3 4.1 4.1.4.2.9.1 1.2-.3l.9-1.4c.4-.6 1.1-.9 1.8-.9l1.8.2c.8.1 1.5.6 1.8 1.4l.7 2c.2.8 0 1.7-.6 2.2l-1.1 1.1c-.7.7-1.8 1-2.8.7-2.9-.8-5.7-2.5-8-4.8s-4-5.1-4.8-8c-.3-1 .1-2.1.7-2.8L6.2 3.1Z" />
                                <path fill="currentColor" d="M16.4 2.1c.2-.2.6-.2.8 0 1.9 1.4 3.5 3 4.8 4.9.2.2.1.6-.1.8l-1 .8c-.2.2-.6.2-.8-.1-1.1-1.5-2.5-2.9-4-4-.3-.2-.3-.5-.1-.8l.4-.6Zm-3.1 3.1c.2-.2.6-.2.8 0 1.4 1 2.7 2.2 3.7 3.7.2.2.1.6-.1.8l-1 .8c-.2.2-.6.1-.8-.1-.9-1.2-2-2.2-3.2-3.1-.3-.2-.3-.5-.1-.8l.7-1.3Zm-3.1 3.1c.2-.2.6-.2.8 0 .9.7 1.7 1.5 2.4 2.4.2.2.1.6-.1.8l-1 .8c-.2.2-.6.1-.8-.1-.6-.7-1.2-1.3-1.9-1.9-.3-.2-.3-.5-.1-.8l.7-1.2Z" />
                            </svg>
                        </span>
                        <span>Llamar: @contactPhone</span>
                    </a>
                </p>
            }
            @if (canWhatsApp && !string.IsNullOrWhiteSpace(whatsappNumber))
            {
                <p>
                    <a class="whatsapp-link" href="https://wa.me/@whatsappNumber" target="_blank" rel="noopener noreferrer">
                        <span class="whatsapp-mark" aria-hidden="true">
                            <svg viewBox="0 0 24 24" role="img" aria-hidden="true">
                                <path fill="currentColor" d="M12 2a10 10 0 0 0-8.54 15.22L2 22l4.92-1.28A10 10 0 1 0 12 2Zm0 18.18a8.18 8.18 0 0 1-4.14-1.12l-.29-.17-2.9.75.77-2.81-.19-.3A8.19 8.19 0 1 1 12 20.18Zm4.75-5.96c-.26-.13-1.51-.74-1.75-.82-.24-.08-.42-.13-.6.12-.17.25-.7.82-.86.98-.16.17-.32.2-.58.07-.26-.13-1.1-.41-2.1-1.29-.78-.69-1.31-1.55-1.47-1.81-.16-.26-.02-.4.11-.52.12-.12.26-.31.39-.46.13-.15.17-.26.25-.43.08-.18.04-.33-.02-.45-.06-.12-.6-1.44-.82-1.97-.22-.53-.45-.46-.61-.47h-.52c-.18 0-.45.06-.69.32-.24.26-.94.9-.94 2.2 0 1.3.95 2.56 1.08 2.75.13.18 1.86 2.84 4.52 3.99.64.28 1.13.44 1.53.56.64.21 1.22.18 1.68.1.52-.07 1.54-.62 1.76-1.24.22-.61.22-1.13.16-1.23-.06-.09-.24-.16-.5-.29Z" />
                            </svg>
                        </span>
                        <span>Whatsapp: @contactPhone</span>
                    </a>
                </p>
            }
            @if (publication.ExpiresAtUtc.HasValue)
            {
                <p>Vence: @publication.ExpiresAtUtc.Value.ToLocalTime().ToString("dd/MM/yyyy")</p>
            }
        </aside>
    </section>

    <section class="detail-stack">
        <article class="detail-panel">
            <h2>Descripción</h2>
            <p>@publication.LongDescription</p>
        </article>
        <article class="detail-panel">
            <div class="section-heading">
                <span class="eyebrow">Ubicación</span>
                <h2>Dónde queda</h2>
            </div>
            @if (publication.Latitude.HasValue && publication.Longitude.HasValue)
            {
                <div class="detail-map-canvas"
                     data-publication-map
                     data-map-mode="detail"
                     data-maptiler-key="@Model.MapTilerKey"
                     data-markers='@Html.Raw(JsonSerializer.Serialize(new[]
                     {
                         new
                         {
                             id = publication.Id,
                             title = displayTitle,
                             image = publication.ImageList.FirstOrDefault(),
                             images = publication.ImageList.Take(11).ToList(),
                             detailsUrl = $"/Publications/Details/{publication.Id}",
                             lat = publication.Latitude,
                             lng = publication.Longitude,
                             price = $"{publication.Currency} {publication.Price:N0}"
                         }
                     }))'></div>
            }
            else
            {
                <div class="empty-state compact-empty">
                    <h3>Sin ubicación disponible</h3>
                    <p>Este anuncio no comparte una ubicación en el mapa.</p>
                </div>
            }
        </article>
        <article class="detail-panel">
            <h2>Ficha técnica</h2>
            <dl class="spec-list">
                @if (publication.PropertyDetail is not null)
                {
                    <div class="spec-item"><dt>Tipo</dt><dd>@publication.PropertyDetail.PropertyType</dd></div>
                    <div class="spec-item"><dt>Operación</dt><dd>@publication.PropertyDetail.Operation</dd></div>
                    <div class="spec-item"><dt>Zona</dt><dd>@publication.PropertyDetail.Zone</dd></div>
                    <div class="spec-item"><dt>Superficie</dt><dd>@publication.PropertyDetail.TotalAreaM2 m²</dd></div>
                    <div class="spec-item"><dt>Ambientes</dt><dd>@publication.PropertyDetail.RoomsOrBedrooms</dd></div>
                }
                else if (publication.VehicleDetail is not null)
                {
                    <div class="spec-item"><dt>Marca</dt><dd>@publication.VehicleDetail.Brand</dd></div>
                    <div class="spec-item"><dt>Modelo</dt><dd>@publication.VehicleDetail.Model</dd></div>
                    <div class="spec-item"><dt>Año</dt><dd>@publication.VehicleDetail.Year</dd></div>
                    <div class="spec-item"><dt>Kilómetros</dt><dd>@publication.VehicleDetail.Kilometers</dd></div>
                    <div class="spec-item"><dt>Combustible</dt><dd>@publication.VehicleDetail.Fuel</dd></div>
                }
                else if (publication.GeneralDetail is not null)
                {
                    <div class="spec-item"><dt>Subcategoría</dt><dd>@publication.GeneralDetail.Subcategory</dd></div>
                    <div class="spec-item"><dt>Estado</dt><dd>@publication.GeneralDetail.ItemCondition</dd></div>
                    <div class="spec-item"><dt>Marca</dt><dd>@publication.GeneralDetail.Brand</dd></div>
                    <div class="spec-item"><dt>Modelo</dt><dd>@publication.GeneralDetail.Model</dd></div>
                    <div class="spec-item"><dt>Garantía</dt><dd>@publication.GeneralDetail.Warranty</dd></div>
                }

                @foreach (var attr in publication.ExtraAttributes)
                {
                    <div class="spec-item"><dt>@attr.Key</dt><dd>@attr.Value</dd></div>
                }
            </dl>
        </article>
    </section>
}

@functions {
    private static string NormalizeWhatsAppNumber(string phone)
    {
        var digits = new string((phone ?? string.Empty).Where(char.IsDigit).ToArray());
        if (digits.StartsWith("549"))
        {
            return digits;
        }

        if (digits.StartsWith("54"))
        {
            return $"549{digits[2..]}";
        }

        return digits;
    }
}
