@model HomeContentViewModel
@{
    var currentMode = string.IsNullOrWhiteSpace(Model.Mode) ? "Galeria" : Model.Mode;
    var currentGroup = string.IsNullOrWhiteSpace(Model.Group) ? "Inmuebles" : Model.Group;
}

<section class="hero-shell">
    <div class="hero-copy">
        <span class="eyebrow">Ventagram en comunidad</span>
        <h1>Basta de <span>anuncios sin precios</span>.</h1>
        <p>Buscá por galería de fotos, clasificados en texto o mapa de ubicaciones para encontrar el aviso que te interesa.</p>
        <div class="hero-actions">
            <a class="primary-pill" href="/Publications/Create">Publicar ahora</a>
            <a class="ghost-pill" href="/Trash">Ver papelera</a>
        </div>
    </div>
    <div class="hero-visual">
        <div class="hero-stat">
            <div class="hero-stat-copy">
                <strong>Búsqueda por galería, texto o mapa</strong>
                <span>Explorá fotos en galería, clasificados en texto y ubicaciones sobre el mapa desde una sola portada.</span>
            </div>
            <img class="hero-stat-logo" src="~/images/logo5.png" alt="Logo de Ventagram" />
        </div>
    </div>
</section>

<section class="status-banner civic-banner">
    <strong>La comunidad decide.</strong>
    <span>Los anuncios denunciados aparecen en la papelera para que todos vean qué publicaciones fueron marcadas.</span>
</section>

<section class="search-panel">
    <form method="get" action="/" class="search-grid">
        <label>
            <span>Qué buscÃ¡s</span>
            <input name="query" value="@Model.Query" placeholder="Ej. departamento, Ford Fiesta, iPhone" />
        </label>
        <label>
            <span>Grupo</span>
            <select name="group">
                @foreach (var group in Model.GroupOptions)
                {
                    if (currentGroup == group.Name)
                    {
                        <option selected>@group.Name</option>
                    }
                    else
                    {
                        <option>@group.Name</option>
                    }
                }
            </select>
        </label>
        <label>
            <span>Vista</span>
            <select name="mode">
                <option selected="@(currentMode == "Mapa")">Mapa</option>
                <option selected="@(currentMode == "Texto")">Texto</option>
                <option selected="@(currentMode == "Galeria")">Galeria</option>
            </select>
        </label>
        <button type="submit" class="primary-pill large">Buscar</button>
    </form>
</section>

@if (!string.IsNullOrWhiteSpace(Model.FlashMessage))
{
    <div class="status-banner">@Model.FlashMessage</div>
}

<section class="group-strip">
    @foreach (var group in Model.GroupOptions)
    {
        <a class="group-chip @(currentGroup == group.Name ? "active" : "")" href="/?group=@group.Name&mode=@currentMode&query=@Model.Query">@group.Name</a>
    }
</section>

<section class="view-switch">
    <a class="view-pill @(currentMode == "Galeria" ? "active" : "")" href="/?group=@currentGroup&mode=Galeria&query=@Model.Query">GalerÃ­a</a>
    <a class="view-pill @(currentMode == "Texto" ? "active" : "")" href="/?group=@currentGroup&mode=Texto&query=@Model.Query">Clasificado</a>
    <a class="view-pill @(currentMode == "Mapa" ? "active" : "")" href="/?group=@currentGroup&mode=Mapa&query=@Model.Query">Mapa</a>
</section>

@if (!Model.Publications.Any())
{
    <section class="empty-state">
        <h2>No hay resultados para esa bÃºsqueda.</h2>
        <p>AjustÃ¡ el grupo o la palabra clave para ver publicaciones activas.</p>
    </section>
}
else if (currentMode == "Mapa")
{
    <section class="map-layout">
        <div class="map-canvas" id="map"
             data-maptiler-key="@Model.MapTilerKey"
             data-markers='@Model.MarkersJson'>
            @if (string.IsNullOrWhiteSpace(Model.MapTilerKey))
            {
                <div class="map-placeholder">
                    <h2>Mapa listo para MapTiler</h2>
                    <p>CargÃ¡ <code>MapTiler:ApiKey</code> en <code>appsettings.json</code> para activar el mapa interactivo.</p>
                </div>
            }
        </div>
        <div class="map-results">
            @foreach (var item in Model.Publications)
            {
                <article class="map-card">
                    <img src="@item.ImageList.FirstOrDefault()" alt="@item.Title" />
                    <div>
                        <span class="card-meta">@item.Category Â· @item.Locality</span>
                        <h3><a href="/Publications/Details/@item.Id">@item.Title</a></h3>
                        <p>@item.ShortDescription</p>
                        <strong>@item.Currency @item.Price.ToString("N0")</strong>
                    </div>
                </article>
            }
        </div>
    </section>
}
else if (currentMode == "Texto")
{
    <section class="classified-list">
        @foreach (var item in Model.Publications)
        {
            var publicationCode = item.ToAdCode();
            <article class="classified-row">
                <div>
                    <span class="card-meta">@item.Group Â· @item.Category Â· @item.Locality</span>
                    <h3><a href="/Publications/Details/@item.Id" class="publication-preview-trigger" data-publication-id="@item.Id" data-details-url="/api/content/details/@item.Id">@item.Title</a></h3>
                    <p>@item.ShortDescription</p>
                </div>
                <div class="classified-side">
                    <strong>@item.Currency @item.Price.ToString("N0")</strong>
                    <button type="button" class="report-float report-trigger" data-publication-id="@item.Id" data-publication-code="@publicationCode" data-publication-title="@item.Title">Denunciar</button>
                </div>
            </article>
        }
    </section>
}
else
{
    <section class="gallery-shell">
        <div class="gallery-header">
            <div>
                <span class="gallery-kicker">Vista galerÃ­a</span>
                <h2>@currentGroup populares en @Model.Publications.First().Locality</h2>
            </div>
        </div>

        <div class="gallery-rail">
            @{ var galleryIndex = 0; }
        @foreach (var item in Model.Publications)
        {
            var publicationCode = item.ToAdCode();
            var galleryTitle = item.Title.Split(" - oportunidad", StringSplitOptions.TrimEntries)[0];
            var galleryImages = item.ImageList.Take(11).ToList();
                <article class="listing-card listing-card-compact" id="@(galleryIndex == 0 ? "gallery-first" : null)">
                    <a href="/Publications/Details/@item.Id" class="card-image-wrap publication-preview-trigger" data-publication-id="@item.Id" data-details-url="/api/content/details/@item.Id">
                        <img src="@galleryImages.FirstOrDefault()" alt="@item.Title" class="gallery-carousel-image" data-images="@string.Join("|||", galleryImages)" data-index="0" />
                        <span class="gallery-badge">@item.Currency @item.Price.ToString("N0")</span>
                        @if (galleryImages.Count > 1)
                        {
                            <button type="button" class="gallery-nav gallery-nav-prev" data-direction="-1" aria-label="Foto anterior">&#8249;</button>
                            <button type="button" class="gallery-nav gallery-nav-next" data-direction="1" aria-label="Foto siguiente">&#8250;</button>
                        }
                        <button type="button" class="gallery-flag report-trigger" data-publication-id="@item.Id" data-publication-code="@publicationCode" data-publication-title="@item.Title" aria-label="Denunciar @item.Title">Denunciar</button>
                        <span class="gallery-title-overlay">@galleryTitle</span>
                    </a>
                </article>
                galleryIndex++;
            }
        </div>
    </section>
}


